rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /stories/{storyId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reviews/{businessId}/{reviewId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
